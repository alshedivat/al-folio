---
---
<article class="pub-card">
  <div>
    {% if entry.abbr %}
      <div class="pub-tag">{{ entry.abbr }}</div>
    {% endif %}
    <span class="pub-year">{{ entry.year }}</span>
  </div>
  <div>
    <div class="pub-title">
      {% if entry.website %}
        <a href="{{ entry.website | relative_url }}">{{ entry.title }}</a>
      {% elsif entry.url %}
        <a href="{{ entry.url }}" target="_blank" rel="noopener">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </div>

    <div class="pub-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains author_last_name -%}
          {%- if site.scholar.first_name contains author.first -%}
            {%- assign author_is_self = true -%}
          {%- endif -%}
        {%- endif -%}
        {%- if forloop.first == false %}, {% endif -%}
        {%- if author_is_self -%}
          <em class="self">{{ author.first }} {{ author.last }}</em>
        {%- else -%}
          {{ author.first }} {{ author.last }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="pub-venue">
      {% if entry.abbr %}<span class="badge">{{ entry.abbr }}</span>{% endif %}
      {% if entry.journal %}{{ entry.journal }}
      {% elsif entry.booktitle %}{{ entry.booktitle }}{% endif %}
      {% if entry.additional_info %} · {{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' | strip }}{% endif %}
    </div>

    {% if entry.abstract %}
      <div class="pub-abstract">{{ entry.abstract }}</div>
    {% endif %}

    {% if entry.tags %}
      <div class="pub-tags">
        {% assign tag_list = entry.tags | split: ', ' %}
        {% for tag in tag_list %}<span>{{ tag }}</span>{% endfor %}
      </div>
    {% endif %}

    <div class="pub-links">
      {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener">DOI</a>{% endif %}
      {% if entry.arxiv %}<a href="http://arxiv.org/abs/{{ entry.arxiv }}" target="_blank" rel="noopener">arXiv</a>{% endif %}
      {% if entry.github %}<a href="{{ entry.github }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" target="_blank" rel="noopener">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" rel="noopener">PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.url and entry.doi == nil and entry.arxiv == nil %}<a href="{{ entry.url }}" target="_blank" rel="noopener">Scholar</a>{% endif %}
    </div>
  </div>
</article>
