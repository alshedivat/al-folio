---
layout: redesign_default
---
<div class="fade-in">

  <!-- Hero -->
  <header class="hero">
    <div class="hero-photo">
      <img src="{{ '/assets/img/pfp.png' | relative_url }}" alt="Wenhao Lu">
    </div>
    <div class="hero-info">
      <div class="hero-role">
        <span class="dot"></span>
        AI SAFETY RESEARCHER
        <span class="pipe">|</span>
        <span class="hero-affil">Millburn High School</span>
      </div>
      <h1 class="hero-name">
        <span class="last">Wenhao</span>
        <span class="accent">Lu</span>
      </h1>
    </div>
  </header>

  <!-- Meta strip -->
  <div class="meta-strip">
    <div class="meta-item">
      <span class="meta-key">loc</span>
      <span>Millburn, NJ</span>
    </div>
    <div class="meta-item">
      <span class="meta-key">mail</span>
      <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
    </div>
    <div class="meta-item">
      <span class="meta-key">scholar</span>
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener">google scholar</a>
    </div>
    <div class="meta-item">
      <span class="meta-key">git</span>
      <a href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener">{{ site.data.socials.github_username }}</a>
    </div>
    <div class="meta-item">
      <span class="meta-key">in</span>
      <a href="https://linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="noopener">{{ site.data.socials.linkedin_username }}</a>
    </div>
  </div>

  <!-- § 01 About -->
  <section>
    <div class="section-head">
      <span class="section-num">§ 01</span>
      <h2 class="section-title">about</h2>
      <div class="section-rule"></div>
    </div>
    <div class="prose">
      {{ content }}
    </div>
    <div class="tag-row">
      <span class="tag">ai-safety</span>
      <span class="tag">interpretability</span>
      <span class="tag">world-models</span>
      <span class="tag">llm-alignment</span>
      <span class="tag">ai4math</span>
      <span class="tag">spectral-graph-theory</span>
    </div>
  </section>

  <!-- § 02 Now -->
  <section>
    <div class="section-head">
      <span class="section-num">§ 02</span>
      <h2 class="section-title">now</h2>
      <div class="section-rule"></div>
    </div>
    <div class="now-grid">
      <a class="now-card" href="https://nxthorizon.org" target="_blank" rel="noopener">
        <span class="now-arrow">↗</span>
        <div class="now-kicker">BUILDING</div>
        <div class="now-title">NEXT Horizon</div>
        <div class="now-desc">STEM talent accelerator for underrepresented students, spanning 25+ countries and 650+ in career pipeline.</div>
        <div class="now-stats">
          <span>25+ countries</span>
          <span>650+ pipeline</span>
          <span>10+ sponsors</span>
        </div>
      </a>
      <a class="now-card" href="https://github.com/Bhavith-Chandra/WorldModelLens" target="_blank" rel="noopener">
        <span class="now-arrow">↗</span>
        <div class="now-kicker">OPEN SOURCE</div>
        <div class="now-title">WorldModelLens</div>
        <div class="now-desc">First interpretability and observability library for world models and SSMs, analogous to TransformerLens.</div>
        <div class="now-stats">
          <span>IRIS · DreamerV3</span>
          <span>V-JEPA</span>
        </div>
      </a>
    </div>
  </section>

  <!-- § 03 Dig deeper -->
  <section>
    <div class="section-head">
      <span class="section-num">§ 03</span>
      <h2 class="section-title">dig deeper</h2>
      <div class="section-rule"></div>
    </div>
    <div class="preview-grid">
      <a class="preview-card" href="{{ '/publications/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">RESEARCH</div>
        <div class="pv-title">Publications</div>
        <div class="pv-desc">Papers in Diabetes, IEEE Xplore, and more.</div>
      </a>
      <a class="preview-card" href="{{ '/projects/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">BUILD</div>
        <div class="pv-title">Projects</div>
        <div class="pv-desc">Graph2Proof, WorldModelLens, CIPHER, and other work.</div>
      </a>
      <a class="preview-card" href="{{ '/cv/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">BACKGROUND</div>
        <div class="pv-title">CV</div>
        <div class="pv-desc">Education, experience, awards.</div>
      </a>
      <a class="preview-card" href="{{ '/blog/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">WRITING</div>
        <div class="pv-title">Blog</div>
        <div class="pv-desc">Essays, ideas, and research notes.</div>
      </a>
      <a class="preview-card" href="{{ '/reading/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">SHELF</div>
        <div class="pv-title">Reading</div>
        <div class="pv-desc">Books, podcasts, and things worth your time.</div>
      </a>
      <a class="preview-card" href="{{ '/contact/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">CONNECT</div>
        <div class="pv-title">Contact</div>
        <div class="pv-desc">Best ways to reach me.</div>
      </a>
    </div>
  </section>

</div>
