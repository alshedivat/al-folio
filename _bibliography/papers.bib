	urldate = {2025-08-24},
	langid = {english},
	abstract = {Wireless and battery-free radio-frequency (RF) sensors can be used to create physical spaces that ambiently sense and respond to human activities. Making such sensors ultra-flexible and transparent is important to preserve the aesthetics of living environments, accommodate daily activities, and functionally integrate with objects. However, existing RF sensors are unable to simultaneously achieve high transparency, flexibility, and the electrical conductivity required for remote room-scale operation. Here, we report 4.5 µm RF tag sensors achieving transparency exceeding 90% that provide capabilities in room-scale ambient wireless sensing. We develop a laser-assisted water-based adhesion-reversion process to digitally realize computer-aided RF design at scale. By individually tagging multiple objects and regions of the human body, we demonstrate multiplexed wireless tracking of human-environment interactions and physiological signals at a range of up to 8 m. These radio-frequency identification sensors open opportunities for non-intrusive wireless sensing of daily living spaces for applications in health monitoring and elderly care.}
}

@inproceedings{nguyenWirelessRespirationTracking2025,
	author={Nguyen, Dat T. and Ho, John S. and Heywood, Daniel and Rajbhandary, Paurakh L.},
	booktitle={2025 IEEE BioSensors Conference (BioSensors),}, 
	title={Wireless Respiration Tracking Using Smart Glasses},
	abbr = {IEEE BioSensors},
	year={2025},
	month=aug,
	pages={1-4},
	keywords={Wireless communication;Wireless sensor networks;Tracking;Pipelines;Radar;Radar tracking;Biosensors;Biomedical monitoring;Intelligent sensors;Smart glasses},
	doi={10.1109/BioSensors65002.2025.11239203},
	url = {https://ieeexplore.ieee.org/document/11239203},
	html = {https://ieeexplore.ieee.org/document/11239203},
	abstract = {The integration of physiological sensing into augmented and virtual reality (AR/VR) systems is a key step toward creating more personalized, responsive and immersive experiences. While heart rate monitoring has been widely explored in wearable devices, respiration tracking remains challenging despite being an equally crucial indicator of physical and emotional states. Here, we present a wireless respiration tracking solution utilizing radar sensors embedded into smart glasses. Through a machine learning-based pipeline, we demonstrate head-worn contactless respiration tracking across a range of user conditions, including rest and motion, achieving respective RMSEs of 2.4 BrPM (at ~53% availability) and 3.2 BrPM (at ~11% availability). Our results suggest that radar-based respiration sensing in head-worn devices can enhance AR/VR applications by adapting to users through real-time physiological feedback.}
}