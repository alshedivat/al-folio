{% assign repo_full = include.repository %}
{% assign parts = repo_full | split: "/" %}
{% assign username = parts[0] %}
{% assign reponame = parts[1] %}

{% assign show_owner = true %}
{% if site.data.repositories.github_users contains username %}
  {% assign show_owner = false %}
{% endif %}

{%- comment -%}
  Pull repo info from jekyll-github-metadata when available:
  site.github.public_repositories is available on GitHub Pages builds,
  and locally if JEKYLL_GITHUB_TOKEN is set and metadata can be fetched.
{%- endcomment -%}

{% assign r = nil %}
{% if site.github and site.github.public_repositories %}
  {% assign matches = site.github.public_repositories | where: "name", reponame %}
  {% assign r = matches | first %}
{% endif %}

<div class="repo card m-2 p-3" style="width: 100%;">
  <div class="d-flex flex-column text-start">
    <div class="d-flex align-items-center justify-content-between">
      <a href="https://github.com/{{ repo_full }}" target="_blank" rel="noopener">
        <strong>
          {% if show_owner %}
            {{ repo_full }}
          {% else %}
            {{ reponame }}
          {% endif %}
        </strong>
      </a>
      {% if r and r.private %}
        <span class="badge bg-secondary ms-2">Private</span>
      {% endif %}
    </div>

    {% if r and r.description %}
      <div class="text-muted mt-2">{{ r.description }}</div>
    {% else %}
      <div class="text-muted mt-2">
        Repo description will appear when GitHub metadata is available.
      </div>
    {% endif %}

    {% if r %}
      <div class="d-flex flex-wrap gap-3 mt-3 small">
        {% if r.language %}
          <span>🧩 {{ r.language }}</span>
        {% endif %}
        <span>⭐ {{ r.stargazers_count }}</span>
        <span>🍴 {{ r.forks_count }}</span>
        {% if r.open_issues_count %}
          <span>🐞 {{ r.open_issues_count }} issues</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>